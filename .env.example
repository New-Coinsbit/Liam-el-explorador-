PORT=3000
# Production requires a dedicated PostgreSQL database. Never reuse another project's DB.
DATABASE_URL=
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Only required to activate photograph-to-questions. Never expose to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Administrative school catalog operations, generated securely per deployment.
ADMIN_KEY=
# Email confirmation and recovery. Tokens expire in 30 minutes.
# Render free web services block standard SMTP ports. Use the HTTPS provider there.
MAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Web push: generate once; preserve the same key pair across releases.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Subject may be the public HTTPS origin of this application.
# Native Android only, after its API URL is configured. Keep blank for web-only.
APP_NATIVE_ORIGIN=
